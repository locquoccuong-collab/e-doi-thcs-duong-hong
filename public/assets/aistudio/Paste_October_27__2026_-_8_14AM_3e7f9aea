 lớp: 7, diemTrương: 'Trường chính' }, { key: '8A', name: 'Chi đội 8A', lớp: 8, diemTrường: 'Trường chính' }, { key: '8B', name: 'Chi đội 8B', lớp: 8, diemTrương: 'Trường chính' }, { key: '9A', name: 'Chi đội 9A', lớp: 9, diemTrương: 'Trường chính' }, { key: '9B', Tên: 'Chi đội 9B', lớp: 9, diemTrương: 'Trường chính' }, // Phân hiệu: đúng 9 lớp (8C thuộc phân hiệu) { key: '6C', name: 'Chi đội 6C', lớp: 6, diemTrương: 'Phân hiệu' }, { key: '6D', name: 'Chi đội 6D', lớp: 6, diemTrương: 'Phân hiệu' }, { key: '7C', name: 'Chi đội 7C', lớp: 7, diemTrương: 'Phân hiệu' }, { key: '7D', name: 'Chi đội 7D', lớp: 7, diemTrương: 'Phân hiệu' }, { key: '8C', name: 'Chi đội 8C', lớp: 8, diemTrương: 'Phân hiệu' }, { key: '8D', name: 'Chi đội 8D', lớp: 8, diemTrương: 'Phân tích' }, { key: '9C', name: 'Chi đội 9C', lớp: 9, diemTrương: 'Phân hiệu' }, { key: '9D', name: 'Chi đội 9D', lớp: 9, diemTrương: 'Phân hiệu' }, { key: '9E', name: 'Chi đội 9E', lớp: 9, diemTrương: 'Phân hiệu' } ]; // 8 NHÓM HỒ SƠ SỐ HÓA ĐỀ XUẤT THEO NHU CẦU QUẢN TRỊ const DEFAULT_HO_SO_GROUPS = [ { id: 1, name: '1. Hồ sơ tổ chức Liên đội, BCH & Phân công nhiệm vụ', desc: 'Quyết định thành lập BCH Liên đội, quy chế làm việc, phân công nhiệm vụ TPT và BCH.', items: [] }, { id: 2, name: '2. Hồ sơ Chi đội & Danh sách Thành viên (17 Chi đội)', mô tả: 'Tự động đồng bộ 17 Chi đội toàn trường; danh sách tên thành viên, cấm chỉ huy chi đội.', item:[] }, { id: 3, tên: '3. Kế hoạch, chương trình công tác & báo cáo', desc: 'Chương trình học, kế hoạch tháng/học kỳ, báo cáo sơ đồ và tổng kết đội.', items: [] }, { id: 4, name: '4. Rèn luyện đội viên, Kết nạp, Trưởng thành & Sinh hoạt', desc: 'Tiến trình rèn luyện đội viên THCS, hồ sơ kết tải Đội, lễ trưởng thành Đội, chuyển sinh hoạt.', items: [] }, { id: 5, name: '5. Nguồn lực, Chiến dịch / Kế hoạch nhỏ được theo dõi', desc: 'Sổ theo dõi nguồn lực phong trào, Kế hoạch nhỏ (Lưu ý: Không thay thế tài chính chính thức của nhà trường).', items: [] }, { id: 6, name: '6. Phân công & Theo dõi hoạt động Đội Cờ đỏ', desc: 'Biên bản trực cờ đỏ, ca trực 2 điểm trường, ghi nhận nền nếp, kiểm tra bán căn.', items: [] }, { id: 7, name: '7. Biên bản, Nghị quyết, Đại hội & Tư liệu truyền thống', desc: 'Biên bản đại hội Liên đội/Chi đội, các nghị quyết, ảnh hoạt động, truyền thống nhà trường.', items: [] }, { id: 8, name: '8. Thi đua, Khen thưởng & Tổng hợp kết quả các tuần', desc: 'Bảng tổng hợp thi đua tuần, tháng, học kỳ; danh sách khen thưởng các chi đội xuất sắc.', items: [] } ]; // BỘ TIÊU CHÍ CHẤM THI ĐUA NỀN NẾP THCS const DEFAULT_TIEU_CHI = [ { id: 1, nhom: 'Chuyên cần', ten: 'Học sinh đi tàn / Vắng học không phép', diem: -2 }, { id: 2, nhom: 'Tác phong', ten: 'Không phải quàng / Sai quy trang phục', diem: -2 }, { id: 3, nhom: 'Vệ sinh', ten: 'Vệ sinh lớp / Khu nội trú chưa sạch', diem: -3 }, { id: 4, nhom: 'Kỷ luật', ten: 'Mất trật tự truy bài 15 phút hoặc giờ học', diem: -2 }, { id: 5, nhom: 'Học tập', ten: 'Tiết không dấu đăng ký đầu bài / học loại C, D', diem: -2 }, { nhận dạng: 6, nhom: 'Bán trú', ten: 'Vi phạm giờ giấc ăn, ở, sinh hoạt bán trú', diem: -3 }, { id: 7, nhom: ' Việc', ten: 'Nhặt của rơi trả lại người mất', diem: 5 }, { id: 8, nhom: ' tốt', ten: 'Gương sáng vượt, giúp bạn giúp đỡ trong học tập', diem: 5 }, { id: 9, nhom: 'Phong trào', ten: 'Thăm gia sản xuất hoạt động Đội / Văn thể mỹ', diem: 5 } ]; // KHỞI TẠO CẤU TRÚC DỮ LIỆU let AppState = { schoolConfig: { schoolName: "Trường PTDTBT THCS Đường Hồng", location: "Xã Đường Hồng, Tuyên Quang", schoolYear: "2026-2027", tptName: "Lộc Quốc Cường", projectStudents: 655, // Số dự kiến ​​ban đầu, có thể chỉnh sửa bất cứ lúc nào diemThresholds: { xuatSac: 95, tot: 85, kha: 70 } }, classData: {}, // key:'6A' -> { key, name, diemTruong, grade, gvcn, siso, chiDoiTruong } weeklyScores: {}, // key: "2026-2027_HK1_W2_6A" -> number listSuViec: [], listThongBao: [], listCoDo: [], listLichCongTac: [], listTieuChi: DEFAULT_TIEU_CHI, hoSoGroups: DEFAULT_HO_SO_GROUPS }; const STORAGE_KEY = "E_DOI_THCS_DUONG_HONG_2026_DATA_V1"; let currentTab = 'ban-lam-viec'; let searchQuery = ''; // TẢI VÀ KHỞI TẠO DỮ LIỆU SẠCH function loadDatabase() { try { const raw = localStorage.getItem(STORAGE_KEY); if (raw) { const parsed = JSON.parse(raw); AppState = Object.assign(AppState, parsed); } else { initCleanDatabase(); } } catch (e) { console.error("Lỗi đọc dữ liệu:", e); initCleanDatabase(); } // Đảm bảo luôn đầy đủ 17 lớp chuẩn CLASS_DEFINITIONS.forEach(c => { if (!AppState.classesData[c.key]) { AppState.classesData[c.key] = { key: c.key, name: c.name,grade: c.grade, diemTrương: c.diemTrương, gvcn: '', // Để trống cho phép sửa siso: null, // Chưa có số thực tế chiDoiTrương: '' }; if (!AppState.hoSoGroups || AppState.hoSoGroups.length === 0) { AppState.hoSoGroups = DEFAULT_HO_SO_GROUPS; } } function initCleanDatabase() { AppState.classesData = {}; CLASS_DEFINITIONS.forEach(c => { AppState.classesData[c.key] = { key: c.key, name: c.name, lớp: c.grade, diemTrường: c.diemTrường, gvcn: '', siso: null, chiDoiTrường: '' }; }); AppState.listSuViec = []; AppState.listThongBao = []; AppState.listCoDo = []; AppState.listLichCongTac = [ { id: 1, loai: 'Tuần', tieuDe: 'Ổn định nền mô đầu năm học và phát động phong trào Đội', thoiGian: 'Tuần 2', nguoiPhuTrach: 'TPT Lộc Quốc Cường' }, { id: 2, loai: 'Tháng', tieuDe: 'Chuẩn bị và tổ chức Đại hội Liên đội nhiệm kỳ 2026-2027', thoiGian: 'Tháng 10/2026', nguoiPhuTrach: 'BCH Liên Đội + TPT' }, { id: 3, loai: 'Học kỳ I', tieuDe: ' Hoạt động chào mừng 20/11 & Phong trào Hoa tốt', thoiGian:'Tháng 11/2026', ngườiPhuTrach: '17 Chi đội' } ]; saveDatabase(); } hàm saveDatabase() { thử { localStorage.setItem(STORAGE_KEY, JSON.stringify(AppState)); updateHeaderAndBadges(); } Catch (err) { Alert("Lỗi lưu trữ cục bộ dữ liệu! Vui lòng kiểm tra trình duyệt cấp lượng."); } } // TIỆN ÍCH AN TOÀN HTML XSS function escapeHtml(str) { if (str === null || str === không xác định) return ''; return String(str) .replace(/&/g, '&') .replace(/</g, '<') .replace(/>